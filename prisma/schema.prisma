// Zanzibar Lounge — réservations et conversations.
//
// Règle : `startsAt` / `endsAt` sont des instants UTC. `serviceDate` est la
// date locale du service (AAAA-MM-JJ) et sert à regrouper une soirée qui
// déborde après minuit — voir src/lib/hours.ts.

// Prisma 7 : l'URL de connexion ne vit plus ici mais dans prisma.config.ts,
// et le client se construit avec un adaptateur (voir src/lib/db.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING // créée, en attente de confirmation du client
  CONFIRMED // confirmée
  SEATED // le client est à table
  COMPLETED // table libérée
  CANCELLED // annulée
  NO_SHOW // ne s'est pas présenté
}

enum OrderStatus {
  PENDING // en attente de préparation
  PREPARING // en cours de préparation
  READY // prête à être récupérée
  COMPLETED // récupérée
  CANCELLED // annulée
}

enum Zone {
  TERRASSE
  SALLE
  SALON
}

enum Channel {
  WEB
  WHATSAPP
  SMS
  PHONE
}

enum MessageRole {
  GUEST
  AGENT
  STAFF
}

/// Établissement (multi-tenancy).
model Restaurant {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  address   String?
  phone     String?
  /// Fuseau horaire IANA (ex: "Africa/Tunis").
  timezone  String  @default("Africa/Tunis")
  /// Langue principale : fr | ar | en.
  locale    String  @default("fr")
  active    Boolean @default(true)

  // ─── SaaS fields ─────────────────────────────────────────────────
  /// Plan d'abonnement.
  plan          SubscriptionPlan @default(FREE)
  /// Stripe Customer ID (cus_…).
  stripeCustomerId String?   @unique
  /// Domaine personnalisé (ex: "reservation.monrestaurant.com").
  customDomain  String?   @unique
  /// Logo URL du restaurant.
  logoUrl       String?
  /// Couleur principale (hex sans #).
  brandColor    String?
  /// Fuseau de limite mensuelle de réservations.
  monthlyReservationLimit Int @default(50)
  /// Nombre de réservations ce mois-ci.
  monthlyReservationCount Int @default(0)
  /// Compteur réinitialisé le premier du mois.
  reservationCountResetAt DateTime?
  /// Paramètres d'intégrations (JSON : { googleCalendar: bool, googleBusiness: bool, tripadvisor: bool }).
  integrationSettings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations     Reservation[]
  tables           RestaurantTable[]
  menuItems        MenuItem[]
  orders           Order[]
  payments         Payment[]
  loyaltyAccounts  LoyaltyAccount[]
  staff            Staff[]
  staffSessions    StaffSession[]
  subscription     Subscription?
  setupTokens      SetupToken[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]

  @@index([slug])
  @@index([stripeCustomerId])
}

model Guest {
  id        String   @id @default(cuid())
  /// Numéro au format E.164, sans espace : +21620123456
  phone     String   @unique
  name      String?
  /// Langue de la dernière conversation : fr | ar | en
  locale    String   @default("fr")
  /// Le client a demandé à ne plus recevoir de messages.
  optedOut  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations      Reservation[]
  conversations     Conversation[]
  reviews           Review[]
  pushSubscriptions PushSubscription[]
  loyaltyAccounts   LoyaltyAccount[]
  orders            Order[]
  payments          Payment[]

  @@index([createdAt])
}

model RestaurantTable {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom affiché en salle : « T4 », « Terrasse 2 »…
  name     String
  capacity Int
  zone     Zone
  active   Boolean @default(true)

  reservations Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Reservation {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Référence courte communiquée au client : ZL-4F2K
  reference String

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  startsAt    DateTime
  endsAt      DateTime
  /// Date locale du service (AAAA-MM-JJ), y compris après minuit.
  serviceDate String
  partySize   Int
  zone        Zone?

  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  status  ReservationStatus @default(CONFIRMED)
  channel Channel
  notes   String?

  reminderSentAt     DateTime?
  confirmedByGuestAt DateTime?
  seatedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  /// « guest » | « staff » | « agent »
  cancelledBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews     Review[]
  payments    Payment[]

  @@index([serviceDate, status])
  @@index([startsAt, status])
  @@index([guestId, startsAt])
  @@unique([restaurantId, reference])
}

model Review {
  id            String  @id @default(cuid())
  guestId       String
  guest         Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  rating        Int
  title         String?
  body          String?
  /// Langue dans laquelle l'avis a été rédigé.
  locale        String  @default("fr")
  /// Avis visible publiquement uniquement après modération.
  approved      Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([approved, createdAt])
  @@index([rating])
}

model Conversation {
  id      String  @id @default(cuid())
  guestId String
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel Channel
  locale  String  @default("fr")
  /// Une conversation close ne repart pas dans le contexte de l'agent.
  closed  Boolean @default(false)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  body           String
  /// Trace brute du fournisseur, utile au débogage d'un webhook.
  providerId     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Vérification du numéro par code court, quand BOOKING_REQUIRE_OTP est actif.
/// Une seule ligne par numéro : une nouvelle demande remplace la précédente.
model PhoneVerification {
  /// Numéro en E.164.
  phone     String   @id
  /// Empreinte du code — le code lui-même n'est jamais stocké.
  codeHash  String
  expiresAt DateTime
  /// Tentatives infructueuses ; au-delà du plafond, il faut redemander un code.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Déduplication des webhooks : les fournisseurs rejouent les livraisons.
model ProcessedEvent {
  /// Identifiant du message chez le fournisseur.
  id        String   @id
  channel   Channel
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Abonnements aux notifications push (Web Push API).
model PushSubscription {
  id        String  @id @default(cuid())
  guestId   String?
  guest     Guest?  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([endpoint])
  @@index([guestId])
}

/// Compte de fidélité d'un client.
model LoyaltyAccount {
  id           String   @id @default(cuid())
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  tier      String   @default("bronze") // bronze | silver | gold
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@unique([guestId, restaurantId])
  @@index([restaurantId])
}

/// Historique des mouvements de points.
model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points    Int      // positif = accumulation, négatif = réclamation
  reason    String   // "reservation_completed" | "review" | "referral" | "redeemed" | "bonus"
  /// Référence optionnelle (ex: numéro de réservation).
  metadata  String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ─── Commandes en ligne ───────────────────────────────────────────────

/// Article du menu (boissons, plats à emporter, etc.).
model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Prix en millimes (ex: 12000 = 12.000 DT).
  price       Int
  category    String  @default("general") // boisson | plat | dessert | general
  imageUrl    String?
  available   Boolean @default(true)
  /// Ordre d'affichage dans la catégorie.
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, category, available])
}

/// Commande passée par un client (à emporter).
model Order {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reference String

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status   OrderStatus @default(PENDING)
  /// Heure souhaitée de récupération (HH:MM, minutes depuis minuit).
  pickupMinutes Int?
  notes    String?
  /// Total en millimes.
  total    Int
  /// Montant du dépôt en millimes (0 = pas de dépôt).
  depositAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payments Payment[]

  @@unique([restaurantId, reference])
  @@index([status, createdAt])
  @@index([guestId, createdAt])
}

/// Ligne de commande.
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity   Int    @default(1)
  /// Prix au moment de la commande (millimes), figé.
  unitPrice  Int

  @@index([orderId])
  @@index([menuItemId])
}

// ─── Paiements ─────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING // en attente de paiement
  SUCCEEDED // paiement réussi
  FAILED // paiement échoué
  REFUNDED // remboursé
  PARTIALLY_REFUNDED // partiellement remboursé
}

enum StaffRole {
  OWNER // propriétaire du restaurant
  MANAGER // gérant
  STAFF // personnel
}

enum SubscriptionPlan {
  FREE // gratuit, 50 réservations/mois
  STARTER // 29€/mois, 500 réservations/mois
  PRO // 79€/mois, illimité
  ENTERPRISE // 199€/mois, white-label, API
}

/// Paiement lié à une commande ou une réservation.
model Payment {
  id        String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Lien optionnel vers une commande.
  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Lien optionnel vers une réservation.
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  guestId String
  guest   Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  /// ID de session Stripe (cs_test_… ou cs_live_…).
  stripeSessionId String?   @unique
  /// ID de paiement Stripe (pi_…).
  stripePaymentId String?
  /// Statut interne du paiement.
  status     PaymentStatus @default(PENDING)
  /// Montant en millimes.
  amount     Int
  /// Devise ISO 4217 (TND, EUR, USD…).
  currency   String   @default("TND")
  /// Description lisible.
  description String?
  /// Métadonnées JSON (ex: { "type": "deposit", "reservationRef": "ZL-4F2K" }).
  metadata   Json?
  /// Date du paiement réussi.
  paidAt     DateTime?
  /// Date du remboursement.
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId, createdAt])
  @@index([orderId])
  @@index([reservationId])
  @@index([status])
}

// ─── SaaS / Multi-tenancy ────────────────────────────────────────

/// Membres de l'équipe d'un restaurant.
model Staff {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Email de connexion (unique par restaurant).
  email        String
  /// Nom affiché.
  name         String
  /// Rôle : owner | manager | staff.
  role         StaffRole @default(STAFF)
  /// Hash du mot de passe (argon2 ou bcrypt).
  passwordHash String
  /// Dernière connexion.
  lastLoginAt  DateTime?
  active       Boolean @default(true)
  /// 2FA TOTP activé.
  twoFactorEnabled Boolean @default(false)
  /// Secret TOTP chiffré (null si 2FA désactivée).
  twoFactorSecret  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions StaffSession[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
}

/// Sessions actives du personnel (PWA staff).
model StaffSession {
  id        String   @id @default(cuid())
  token     String   @unique
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([staffId])
  @@index([restaurantId])
}

/// Abonnement Stripe d'un restaurant.
model Subscription {
  id           String  @id @default(cuid())
  restaurantId String  @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// ID d'abonnement Stripe (sub_…).
  stripeSubscriptionId String?   @unique
  /// ID du prix Stripe (price_…).
  stripePriceId String?
  /// Statut : trialing | active | past_due | canceled | unpaid
  status        String   @default("inactive")
  /// Date de début.
  currentPeriodStart DateTime?
  /// Date de fin.
  currentPeriodEnd   DateTime?
  /// Annulation en fin de période.
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
  @@index([stripeSubscriptionId])
}

/// Tokens d'onboarding (utilisés lors de l'inscription).
model SetupToken {
  id        String   @id @default(cuid())
  /// Token unique (sécurisé, aléatoire).
  token     String   @unique
  /// Email du propriétaire.
  email     String
  /// Nom du restaurant.
  restaurantName String?
  /// Statut : pending | used | expired
  status    String   @default("pending")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([email])
}

/// Endpoints webhooks de l'API publique.
model WebhookEndpoint {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom descriptif de l'endpoint.
  name         String?
  /// URL de l'endpoint.
  url          String
  /// Événements écoutés (ex: ["reservation.created", "order.updated"]).
  events       String[]
  /// Secret pour signer les payloads.
  secret       String
  active       Boolean @default(true)
  /// Dernière tentative de livraison.
  lastDeliveryAt    DateTime?
  /// Dernier statut de livraison : success | failed | pending.
  lastDeliveryStatus String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([restaurantId])
}

/// Livraisons de webhooks avec suivi de statut et retry.
model WebhookDelivery {
  id           String  @id @default(cuid())
  webhookId    String
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  /// Statut : pending | success | failed.
  status       String  @default("pending")
  /// Nombre de tentatives (max 3).
  attempts     Int     @default(0)
  /// Dernière erreur si échec.
  lastError    String?
  /// Réponse HTTP du endpoint (code + headers).
  responseStatus Int?
  createdAt    DateTime @default(now())
  completedAt DateTime?

  @@index([webhookId, createdAt])
  @@index([status])
}

/// Journal d'audit des actions de sécurité.
model AuditLog {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Type d'action (ex: "2fa.enabled", "webhook.created", "staff.login").
  action       String
  /// ID de l'acteur (staffId ou null pour les actions système).
  actorId      String?
  actorEmail   String?
  /// Détails supplémentaires (JSON serializable).
  details      Json?
  /// Adresse IP de la requête.
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
}

/// Clés API pour l'authentification des webhooks.
model ApiKey {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom descriptif de la clé.
  name         String
  /// Préfixe de la clé (premes 8 caractères) pour l'identification.
  keyPrefix    String
  /// Hash de la clé complète (SHA-256).
  keyHash      String
  active       Boolean @default(true)
  /// Dernière utilisation.
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([restaurantId])
  @@index([keyPrefix])
}
