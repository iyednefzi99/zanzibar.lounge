// Zanzibar Lounge — réservations et conversations.
//
// Règle : `startsAt` / `endsAt` sont des instants UTC. `serviceDate` est la
// date locale du service (AAAA-MM-JJ) et sert à regrouper une soirée qui
// déborde après minuit — voir src/lib/hours.ts.

// Prisma 7 : l'URL de connexion ne vit plus ici mais dans prisma.config.ts,
// et le client se construit avec un adaptateur (voir src/lib/db.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING // créée, en attente de confirmation du client
  CONFIRMED // confirmée
  SEATED // le client est à table
  COMPLETED // table libérée
  CANCELLED // annulée
  NO_SHOW // ne s'est pas présenté
}

enum OrderStatus {
  PENDING // en attente de préparation
  PREPARING // en cours de préparation
  READY // prête à être récupérée
  COMPLETED // récupérée
  CANCELLED // annulée
}

enum Zone {
  TERRASSE
  SALLE
  SALON
}

enum Channel {
  WEB
  WHATSAPP
  SMS
  PHONE
}

enum MessageRole {
  GUEST
  AGENT
  STAFF
}

/// Établissement (multi-tenancy).
model Restaurant {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  address   String?
  phone     String?
  /// Fuseau horaire IANA (ex: "Africa/Tunis").
  timezone  String  @default("Africa/Tunis")
  /// Langue principale : fr | ar | en.
  locale    String  @default("fr")
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  tables       RestaurantTable[]
  menuItems    MenuItem[]
  orders       Order[]
  loyaltyAccounts LoyaltyAccount[]

  @@index([slug])
}

model Guest {
  id        String   @id @default(cuid())
  /// Numéro au format E.164, sans espace : +21620123456
  phone     String   @unique
  name      String?
  /// Langue de la dernière conversation : fr | ar | en
  locale    String   @default("fr")
  /// Le client a demandé à ne plus recevoir de messages.
  optedOut  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations      Reservation[]
  conversations     Conversation[]
  reviews           Review[]
  pushSubscriptions PushSubscription[]
  loyaltyAccounts   LoyaltyAccount[]
  orders            Order[]

  @@index([createdAt])
}

model RestaurantTable {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom affiché en salle : « T4 », « Terrasse 2 »…
  name     String
  capacity Int
  zone     Zone
  active   Boolean @default(true)

  reservations Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Reservation {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Référence courte communiquée au client : ZL-4F2K
  reference String

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  startsAt    DateTime
  endsAt      DateTime
  /// Date locale du service (AAAA-MM-JJ), y compris après minuit.
  serviceDate String
  partySize   Int
  zone        Zone?

  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  status  ReservationStatus @default(CONFIRMED)
  channel Channel
  notes   String?

  reminderSentAt     DateTime?
  confirmedByGuestAt DateTime?
  seatedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  /// « guest » | « staff » | « agent »
  cancelledBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@index([serviceDate, status])
  @@index([startsAt, status])
  @@index([guestId, startsAt])
  @@unique([restaurantId, reference])
}

model Review {
  id            String  @id @default(cuid())
  guestId       String
  guest         Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  rating        Int
  title         String?
  body          String?
  /// Langue dans laquelle l'avis a été rédigé.
  locale        String  @default("fr")
  /// Avis visible publiquement uniquement après modération.
  approved      Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([approved, createdAt])
  @@index([rating])
}

model Conversation {
  id      String  @id @default(cuid())
  guestId String
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel Channel
  locale  String  @default("fr")
  /// Une conversation close ne repart pas dans le contexte de l'agent.
  closed  Boolean @default(false)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  body           String
  /// Trace brute du fournisseur, utile au débogage d'un webhook.
  providerId     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Vérification du numéro par code court, quand BOOKING_REQUIRE_OTP est actif.
/// Une seule ligne par numéro : une nouvelle demande remplace la précédente.
model PhoneVerification {
  /// Numéro en E.164.
  phone     String   @id
  /// Empreinte du code — le code lui-même n'est jamais stocké.
  codeHash  String
  expiresAt DateTime
  /// Tentatives infructueuses ; au-delà du plafond, il faut redemander un code.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Déduplication des webhooks : les fournisseurs rejouent les livraisons.
model ProcessedEvent {
  /// Identifiant du message chez le fournisseur.
  id        String   @id
  channel   Channel
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Abonnements aux notifications push (Web Push API).
model PushSubscription {
  id        String  @id @default(cuid())
  guestId   String?
  guest     Guest?  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([endpoint])
  @@index([guestId])
}

/// Compte de fidélité d'un client.
model LoyaltyAccount {
  id           String   @id @default(cuid())
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  tier      String   @default("bronze") // bronze | silver | gold
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@unique([guestId, restaurantId])
  @@index([restaurantId])
}

/// Historique des mouvements de points.
model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points    Int      // positif = accumulation, négatif = réclamation
  reason    String   // "reservation_completed" | "review" | "referral" | "redeemed" | "bonus"
  /// Référence optionnelle (ex: numéro de réservation).
  metadata  String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ─── Commandes en ligne ───────────────────────────────────────────────

/// Article du menu (boissons, plats à emporter, etc.).
model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Prix en millimes (ex: 12000 = 12.000 DT).
  price       Int
  category    String  @default("general") // boisson | plat | dessert | general
  imageUrl    String?
  available   Boolean @default(true)
  /// Ordre d'affichage dans la catégorie.
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items OrderItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, category, available])
}

/// Commande passée par un client (à emporter).
model Order {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reference String

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status   OrderStatus @default(PENDING)
  /// Heure souhaitée de récupération (HH:MM, minutes depuis minuit).
  pickupMinutes Int?
  notes    String?
  /// Total en millimes.
  total    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([restaurantId, reference])
  @@index([status, createdAt])
  @@index([guestId, createdAt])
}

/// Ligne de commande.
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity   Int    @default(1)
  /// Prix au moment de la commande (millimes), figé.
  unitPrice  Int

  @@index([orderId])
  @@index([menuItemId])
}
