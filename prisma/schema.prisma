// E-Coffee Node — réservations et conversations.
//
// Règle : `startsAt` / `endsAt` sont des instants UTC. `serviceDate` est la
// date locale du service (AAAA-MM-JJ) et sert à regrouper une soirée qui
// déborde après minuit — voir src/lib/hours.ts.

// Prisma 7 : l'URL de connexion ne vit plus ici mais dans prisma.config.ts,
// et le client se construit avec un adaptateur (voir src/lib/db.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  RESERVATION_REMINDER
  ORDER_READY
  FLASH_OFFER
  BIRTHDAY
  SYSTEM
  ANNOUNCEMENT
}

enum ReservationStatus {
  PENDING // créée, en attente de confirmation du client
  CONFIRMED // confirmée
  SEATED // le client est à table
  COMPLETED // table libérée
  CANCELLED // annulée
  NO_SHOW // ne s'est pas présenté
}

enum OrderStatus {
  PENDING // en attente de préparation
  PREPARING // en cours de préparation
  READY // prête à être récupérée
  COMPLETED // récupérée
  CANCELLED // annulée
}

enum Zone {
  TERRASSE
  SALLE
  SALON
}

enum Channel {
  WEB
  WHATSAPP
  SMS
  PHONE
}

enum MessageRole {
  GUEST
  AGENT
  STAFF
}

/// Établissement (multi-tenancy).
model Restaurant {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  address   String?
  phone     String?
  /// Fuseau horaire IANA (ex: "Africa/Tunis").
  timezone  String  @default("Africa/Tunis")
  /// Langue principale : fr | ar | en.
  locale    String  @default("fr")
  active    Boolean @default(true)

  // ─── SaaS fields ─────────────────────────────────────────────────
  /// Plan d'abonnement.
  plan          SubscriptionPlan @default(FREE)
  /// Stripe Customer ID (cus_…).
  stripeCustomerId String?   @unique
  /// Domaine personnalisé (ex: "reservation.monrestaurant.com").
  customDomain  String?   @unique
  /// Logo URL du restaurant.
  logoUrl       String?
  /// Couleur principale (hex sans #).
  brandColor    String?
  /// Fuseau de limite mensuelle de réservations.
  monthlyReservationLimit Int @default(50)
  /// Nombre de réservations ce mois-ci.
  monthlyReservationCount Int @default(0)
  /// Compteur réinitialisé le premier du mois.
  reservationCountResetAt DateTime?
  /// Paramètres d'intégrations (JSON : { googleCalendar: bool, googleBusiness: bool, tripadvisor: bool }).
  integrationSettings Json?

  // ─── Discovery / Marketplace fields ─────────────────────────────────
  description     String?
  cuisineTypes    String[]
  priceRange      Int      @default(2) // 1-4
  latitude        Float?
  longitude       Float?
  coverImage      String?
  galleryImages   String[]
  featured        Boolean  @default(false)
  featuredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations     Reservation[]
  tables           RestaurantTable[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  orders           Order[]
  payments         Payment[]
  loyaltyAccounts  LoyaltyAccount[]
  staff            Staff[]
  staffSessions    StaffSession[]
  subscription     Subscription?
  setupTokens      SetupToken[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]
  notifications    Notification[]
  inventory        Inventory[]
  referrals        Referral[]
  waitlist         Waitlist[]
  events           Event[]
  gallery          Gallery[]
  posIntegrations  PosIntegration[]
  guestTags        GuestTag[]
  guestNotes       GuestNote[]
  campaigns        Campaign[]
  shifts           Shift[]
  availabilities   StaffAvailability[]
  timeEntries      TimeEntry[]
  preAuthorizations PreAuthorization[]
  billSplits       BillSplit[]

  @@index([slug])
  @@index([stripeCustomerId])
}

model Guest {
  id        String   @id @default(cuid())
  /// Numéro au format E.164, sans espace : +21620123456
  phone     String   @unique
  name      String?
  /// Langue de la dernière conversation : fr | ar | en
  locale    String   @default("fr")
  /// Le client a demandé à ne plus recevoir de messages.
  optedOut  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations      Reservation[]
  conversations     Conversation[]
  reviews           Review[]
  pushSubscriptions PushSubscription[]
  loyaltyAccounts   LoyaltyAccount[]
  orders            Order[]
  payments          Payment[]
  notifications     Notification[]
  profile           GuestProfile?
  referralsMade     Referral[] @relation("ReferralsMade")
  referralsReceived Referral[] @relation("ReferralsReceived")
  waitlist          Waitlist[]
  eventBookings     EventBooking[]
  tags              GuestTagAssignment[]
  notes             GuestNote[]
  campaignDeliveries CampaignDelivery[]
  preAuthorizations PreAuthorization[]

  @@index([createdAt])
}

/// Profil étendu du client pour l'app mobile.
model GuestProfile {
  id               String   @id @default(cuid())
  guestId          String   @unique
  guest            Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  displayName      String?
  avatarUrl        String?
  /// Préférences structurées (JSON : { notifications, dietary, ... }).
  preferences      Json     @default("{}")
  birthday         DateTime?
  /// Zone préférée : TERRASSE | SALLE | SALON.
  favoriteZone     String?
  /// Taille de groupe par défaut pour les réservations rapides.
  defaultPartySize Int      @default(2)
  /// Langue de l'app : fr | ar | en.
  language         String   @default("fr")
  /// Notifications push activées.
  pushEnabled      Boolean  @default(true)
  /// Recevoir les offres par email.
  emailOptIn       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
}

model RestaurantTable {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom affiché en salle : « T4 », « Terrasse 2 »…
  name     String
  capacity Int
  zone     Zone
  active   Boolean @default(true)

  reservations Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Reservation {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Référence courte communiquée au client : ZL-4F2K
  reference String

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  startsAt    DateTime
  endsAt      DateTime
  /// Date locale du service (AAAA-MM-JJ), y compris après minuit.
  serviceDate String
  partySize   Int
  zone        Zone?

  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  status  ReservationStatus @default(CONFIRMED)
  channel Channel
  notes   String?

  reminderSentAt     DateTime?
  confirmedByGuestAt DateTime?
  seatedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  /// « guest » | « staff » | « agent »
  cancelledBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews     Review[]
  payments    Payment[]
  preAuthorizations PreAuthorization[]
  billSplits  BillSplit[]

  @@index([serviceDate, status])
  @@index([startsAt, status])
  @@index([guestId, startsAt])
  @@unique([restaurantId, reference])
}

model Review {
  id            String  @id @default(cuid())
  guestId       String
  guest         Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  rating        Int
  title         String?
  body          String?
  /// Langue dans laquelle l'avis a été rédigé.
  locale        String  @default("fr")
  /// Avis visible publiquement uniquement après modération.
  approved      Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([approved, createdAt])
  @@index([rating])
}

model Conversation {
  id      String  @id @default(cuid())
  guestId String
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel Channel
  locale  String  @default("fr")
  /// Une conversation close ne repart pas dans le contexte de l'agent.
  closed  Boolean @default(false)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  body           String
  /// Trace brute du fournisseur, utile au débogage d'un webhook.
  providerId     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Vérification du numéro par code court, quand BOOKING_REQUIRE_OTP est actif.
/// Une seule ligne par numéro : une nouvelle demande remplace la précédente.
model PhoneVerification {
  /// Numéro en E.164.
  phone     String   @id
  /// Empreinte du code — le code lui-même n'est jamais stocké.
  codeHash  String
  expiresAt DateTime
  /// Tentatives infructueuses ; au-delà du plafond, il faut redemander un code.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Déduplication des webhooks : les fournisseurs rejouent les livraisons.
model ProcessedEvent {
  /// Identifiant du message chez le fournisseur.
  id        String   @id
  channel   Channel
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Abonnements aux notifications push (Web Push API).
model PushSubscription {
  id        String  @id @default(cuid())
  guestId   String?
  guest     Guest?  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([endpoint])
  @@index([guestId])
}

/// Compte de fidélité d'un client.
model LoyaltyAccount {
  id           String   @id @default(cuid())
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  tier      String   @default("bronze") // bronze | silver | gold
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@unique([guestId, restaurantId])
  @@index([restaurantId])
}

/// Historique des mouvements de points.
model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points    Int      // positif = accumulation, négatif = réclamation
  reason    String   // "reservation_completed" | "review" | "referral" | "redeemed" | "bonus"
  /// Référence optionnelle (ex: numéro de réservation).
  metadata  String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ─── Menu & Inventaire ──────────────────────────────────────────────

/// Catégorie de menu (ex: Entrées, Plats, Boissons).
model MenuCategory {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
  /// Emoji ou identifiant d'icône (ex: "🍽️", "🍷").
  icon         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, active, sortOrder])
}

/// Article du menu (boissons, plats à emporter, etc.).
model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Lien optionnel vers une catégorie structurée.
  categoryId   String?
  categoryRel  MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  /// Prix en millimes (ex: 12000 = 12.000 DT).
  price       Int
  /// Catégorie texte legacy (boisson | plat | dessert | general).
  category    String  @default("general")
  imageUrl    String?
  available   Boolean @default(true)
  /// Ordre d'affichage dans la catégorie.
  sortOrder   Int     @default(0)
  /// Allergènes (ex: ["gluten", "lactose", "noix"]).
  allergens   String[]
  /// Nombre de calories (optionnel).
  calories    Int?
  /// Temps de préparation en minutes (optionnel).
  preparationTime Int?
  /// Article saisonnier / spécial du jour.
  seasonal    Boolean @default(false)
  /// Fenêtre de disponibilité (optionnel, UTC).
  availableFrom  DateTime?
  availableUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       OrderItem[]
  inventory   Inventory[]

  @@unique([restaurantId, name])
  @@index([restaurantId, available, seasonal])
  @@index([categoryId, sortOrder])
}

/// Article d'inventaire (ingrédient, consommable).
model Inventory {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Lien optionnel vers un article du menu (pour déduction automatique).
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name         String
  /// Quantité en stock.
  quantity     Float
  /// Unité (kg, L, pièce, etc.).
  unit         String
  /// Seuil minimum avant alerte.
  minQuantity  Float
  /// Dernière mise à jour.
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())

  logs InventoryLog[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// Journal des mouvements de stock.
model InventoryLog {
  id          String   @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  /// Variation de quantité (positif = réappro, négatif = consommation).
  change      Float
  /// Raison du mouvement (ex: "commande CMD-ABCD", "réappro manuelle").
  reason      String
  createdAt   DateTime @default(now())

  @@index([inventoryId, createdAt])
}

/// Commande passée par un client (à emporter).
model Order {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reference String

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status   OrderStatus @default(PENDING)
  /// Heure souhaitée de récupération (HH:MM, minutes depuis minuit).
  pickupMinutes Int?
  notes    String?
  /// Total en millimes.
  total    Int
  /// Montant du dépôt en millimes (0 = pas de dépôt).
  depositAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payments Payment[]

  @@unique([restaurantId, reference])
  @@index([status, createdAt])
  @@index([guestId, createdAt])
}

/// Ligne de commande.
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity   Int    @default(1)
  /// Prix au moment de la commande (millimes), figé.
  unitPrice  Int

  @@index([orderId])
  @@index([menuItemId])
}

// ─── Paiements ─────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING // en attente de paiement
  SUCCEEDED // paiement réussi
  FAILED // paiement échoué
  REFUNDED // remboursé
  PARTIALLY_REFUNDED // partiellement remboursé
}

enum StaffRole {
  OWNER // propriétaire du restaurant
  MANAGER // gérant
  STAFF // personnel
}

enum SubscriptionPlan {
  FREE // gratuit, 50 réservations/mois
  STARTER // 29€/mois, 500 réservations/mois
  PRO // 79€/mois, illimité
  ENTERPRISE // 199€/mois, white-label, API
}

/// Paiement lié à une commande ou une réservation.
model Payment {
  id        String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Lien optionnel vers une commande.
  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Lien optionnel vers une réservation.
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  guestId String
  guest   Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  /// ID de session Stripe (cs_test_… ou cs_live_…).
  stripeSessionId String?   @unique
  /// ID de paiement Stripe (pi_…).
  stripePaymentId String?
  /// Statut interne du paiement.
  status     PaymentStatus @default(PENDING)
  /// Montant en millimes.
  amount     Int
  /// Devise ISO 4217 (TND, EUR, USD…).
  currency   String   @default("TND")
  /// Description lisible.
  description String?
  /// Métadonnées JSON (ex: { "type": "deposit", "reservationRef": "ZL-4F2K" }).
  metadata   Json?
  /// Date du paiement réussi.
  paidAt     DateTime?
  /// Date du remboursement.
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId, createdAt])
  @@index([orderId])
  @@index([reservationId])
  @@index([status])
}

// ─── SaaS / Multi-tenancy ────────────────────────────────────────

/// Membres de l'équipe d'un restaurant.
model Staff {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Email de connexion (unique par restaurant).
  email        String
  /// Nom affiché.
  name         String
  /// Rôle : owner | manager | staff.
  role         StaffRole @default(STAFF)
  /// Hash du mot de passe (argon2 ou bcrypt).
  passwordHash String
  /// Dernière connexion.
  lastLoginAt  DateTime?
  active       Boolean @default(true)
  /// 2FA TOTP activé.
  twoFactorEnabled Boolean @default(false)
  /// Secret TOTP chiffré (null si 2FA désactivée).
  twoFactorSecret  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions StaffSession[]
  notifications Notification[]
  shifts         Shift[]
  availabilities StaffAvailability[]
  timeEntries    TimeEntry[]
  authoredNotes  GuestNote[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
}

/// Sessions actives du personnel (PWA staff).
model StaffSession {
  id        String   @id @default(cuid())
  token     String   @unique
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([staffId])
  @@index([restaurantId])
}

/// Abonnement Stripe d'un restaurant.
model Subscription {
  id           String  @id @default(cuid())
  restaurantId String  @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// ID d'abonnement Stripe (sub_…).
  stripeSubscriptionId String?   @unique
  /// ID du prix Stripe (price_…).
  stripePriceId String?
  /// Statut : trialing | active | past_due | canceled | unpaid
  status        String   @default("inactive")
  /// Date de début.
  currentPeriodStart DateTime?
  /// Date de fin.
  currentPeriodEnd   DateTime?
  /// Annulation en fin de période.
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
  @@index([stripeSubscriptionId])
}

/// Tokens d'onboarding (utilisés lors de l'inscription).
model SetupToken {
  id        String   @id @default(cuid())
  /// Token unique (sécurisé, aléatoire).
  token     String   @unique
  /// Email du propriétaire.
  email     String
  /// Nom du restaurant.
  restaurantName String?
  /// Statut : pending | used | expired
  status    String   @default("pending")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([email])
}

/// Endpoints webhooks de l'API publique.
model WebhookEndpoint {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom descriptif de l'endpoint.
  name         String?
  /// URL de l'endpoint.
  url          String
  /// Événements écoutés (ex: ["reservation.created", "order.updated"]).
  events       String[]
  /// Secret pour signer les payloads.
  secret       String
  active       Boolean @default(true)
  /// Dernière tentative de livraison.
  lastDeliveryAt    DateTime?
  /// Dernier statut de livraison : success | failed | pending.
  lastDeliveryStatus String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([restaurantId])
}

/// Livraisons de webhooks avec suivi de statut et retry.
model WebhookDelivery {
  id           String  @id @default(cuid())
  webhookId    String
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  /// Statut : pending | success | failed.
  status       String  @default("pending")
  /// Nombre de tentatives (max 3).
  attempts     Int     @default(0)
  /// Dernière erreur si échec.
  lastError    String?
  /// Réponse HTTP du endpoint (code + headers).
  responseStatus Int?
  createdAt    DateTime @default(now())
  completedAt DateTime?

  @@index([webhookId, createdAt])
  @@index([status])
}

/// Journal d'audit des actions de sécurité.
model AuditLog {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Type d'action (ex: "2fa.enabled", "webhook.created", "staff.login").
  action       String
  /// ID de l'acteur (staffId ou null pour les actions système).
  actorId      String?
  actorEmail   String?
  /// Détails supplémentaires (JSON serializable).
  details      Json?
  /// Adresse IP de la requête.
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, action])
}

/// Notifications in-app pour les clients et le personnel.
model Notification {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String
  /// Données structurées (ex: { reservationRef: "ZL-4F2K" }).
  data         Json?
  read         Boolean          @default(false)
  /// Lien de destination au clic (ex: "/reservation/ZL-4F2K").
  actionUrl    String?
  createdAt    DateTime         @default(now())
  readAt       DateTime?

  /// Cible : un client, un membre du personnel, ou les deux (broadcast).
  guestId  String?
  guest    Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  staffId  String?
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Vrai si la notification s'adresse à tout le monde.
  broadcast Boolean @default(false)

  @@index([restaurantId, read, createdAt])
  @@index([guestId, read])
  @@index([staffId, read])
  @@index([createdAt])
}

/// Clés API pour l'authentification des webhooks.
model ApiKey {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Nom descriptif de la clé.
  name         String
  /// Préfixe de la clé (premes 8 caractères) pour l'identification.
  keyPrefix    String
  /// Hash de la clé complète (SHA-256).
  keyHash      String
  active       Boolean @default(true)
  /// Dernière utilisation.
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([restaurantId])
  @@index([keyPrefix])
}

// ─── Social & Community ─────────────────────────────────────────────

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FULL
}

enum EventBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Parrainage : un client existant invite un nouveau client.
model Referral {
  id              String         @id @default(cuid())
  referrerGuestId String
  referrerGuest   Guest          @relation("ReferralsMade", fields: [referrerGuestId], references: [id], onDelete: Cascade)
  referredGuestId String?
  referredGuest   Guest?         @relation("ReferralsReceived", fields: [referredGuestId], references: [id], onDelete: SetNull)
  restaurantId    String
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Code court de parrainage (ex: ZL-ABCD).
  code            String         @unique
  status          ReferralStatus @default(PENDING)
  /// Points attribués au parrain et au filleul.
  rewardPoints    Int            @default(10)
  createdAt       DateTime       @default(now())

  @@index([code])
  @@index([referrerGuestId])
  @@index([restaurantId])
}

/// File d'attente : un client s'inscrit pour une date donnée.
model Waitlist {
  id           String         @id @default(cuid())
  guestId      String
  guest        Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Date de service souhaitée (AAAA-MM-JJ).
  date         String
  partySize    Int
  status       WaitlistStatus @default(WAITING)
  /// Position dans la file (1 = premier).
  position     Int
  createdAt    DateTime       @default(now())

  @@index([restaurantId, date, status])
  @@index([guestId])
}

/// Événement organisé par le restaurant.
model Event {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  /// Date de l'événement (AAAA-MM-JJ).
  date         String
  /// Heure de début (HH:MM).
  startTime    String
  capacity     Int
  /// Prix en millimes (0 = gratuit).
  price        Int         @default(0)
  imageUrl     String?
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  bookings EventBooking[]

  @@index([restaurantId, date, status])
}

/// Réservation d'un événement par un client.
model EventBooking {
  id        String              @id @default(cuid())
  eventId   String
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  quantity  Int                 @default(1)
  status    EventBookingStatus  @default(CONFIRMED)
  createdAt DateTime            @default(now())

  @@unique([eventId, guestId])
  @@index([guestId])
}

  /// Galerie photos du restaurant.
model Gallery {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, sortOrder])
}

// ─── POS Integration ────────────────────────────────────────────────

/// Intégration avec un système POS externe.
model PosIntegration {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Fournisseur POS : "toast" | "square" | "lightspeed" | "clover" | "custom"
  provider     String
  /// Clé API chiffrée.
  apiKey       String?
  /// Secret API chiffré.
  apiSecret    String?
  /// ID du site/lieu externe.
  locationId   String?
  /// Synchroniser le menu depuis le POS.
  syncMenu     Boolean  @default(true)
  /// Synchroniser les commandes depuis le POS.
  syncOrders   Boolean  @default(false)
  /// Synchroniser les paiements depuis le POS.
  syncPayments Boolean  @default(false)
  /// Dernière synchronisation.
  lastSyncAt   DateTime?
  /// Statut : idle | syncing | error
  syncStatus   String   @default("idle")
  /// Message d'erreur si échec.
  syncError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs PosSyncLog[]

  @@unique([restaurantId, provider])
  @@index([restaurantId])
}

/// Journal des synchronisations POS.
model PosSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  integration   PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Direction : "import" | "export"
  direction     String
  /// Type d'entité : "menu" | "order" | "payment"
  entityType    String
  /// ID de l'entité synchro.
  entityId      String?
  /// Statut : "success" | "error" | "skipped"
  status        String
  /// Détails supplémentaires.
  details       Json?
  createdAt     DateTime @default(now())

  @@index([integrationId, createdAt])
}

// ─── CRM & Marketing ───────────────────────────────────────────────

/// Tag personnalisé pour les clients.
model GuestTag {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  color        String   @default("#C9A96E")
  createdAt    DateTime @default(now())

  assignments GuestTagAssignment[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// Assignment d'un tag à un client.
model GuestTagAssignment {
  id         String    @id @default(cuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tagId      String
  tag        GuestTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([guestId, tagId])
  @@index([guestId])
  @@index([tagId])
}

/// Note interne du staff sur un client.
model GuestNote {
  id           String   @id @default(cuid())
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guestId])
  @@index([restaurantId])
}

/// Campagne marketing.
model Campaign {
  id              String   @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  /// Type : "email" | "sms" | "push" | "whatsapp"
  type            String
  subject         String?
  /// Contenu HTML ou texte.
  content         String
  /// Statut : "draft" | "scheduled" | "sending" | "sent" | "paused"
  status          String   @default("draft")
  scheduledAt     DateTime?
  sentAt          DateTime?
  sentCount       Int      @default(0)
  openCount       Int      @default(0)
  clickCount      Int      @default(0)
  conversionCount Int      @default(0)
  /// Filtres cible (JSON).
  targetSegment   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveries CampaignDelivery[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

/// Livraison d'une campagne à un client.
model CampaignDelivery {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  /// Canal : "email" | "sms" | "push" | "whatsapp"
  channel    String
  /// Statut : "pending" | "sent" | "delivered" | "opened" | "clicked" | "failed"
  status     String   @default("pending")
  sentAt     DateTime?
  deliveredAt DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  errorMessage String?
  createdAt  DateTime @default(now())

  @@index([campaignId, status])
  @@index([guestId])
  @@index([campaignId, createdAt])
}

// ─── Scheduling / Staff ────────────────────────────────────────────

/// Shift de travail.
model Shift {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startTime    String
  endTime      String
  /// Rôle : "SERVER" | "HOST" | "KITCHEN" | "BAR"
  role         String   @default("SERVER")
  /// Statut : "scheduled" | "confirmed" | "completed" | "cancelled"
  status       String   @default("scheduled")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, date])
  @@index([staffId, date])
}

/// Disponibilité d'un membre du staff.
model StaffAvailability {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// Jour de la semaine (0=Dim, 6=Sam)
  dayOfWeek    Int
  startTime    String
  endTime      String
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([staffId, dayOfWeek])
}

/// Pointage (entrée/sortie).
model TimeEntry {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  clockIn      DateTime
  clockOut     DateTime?
  breakMinutes Int      @default(0)
  totalHours   Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([staffId, createdAt])
  @@index([restaurantId, clockIn])
}

// ─── Payments Advanced ─────────────────────────────────────────────

/// Pré-autorisation Stripe.
model PreAuthorization {
  id                     String   @id @default(cuid())
  reservationId          String
  reservation            Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId                String
  guest                  Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  restaurantId           String
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  stripePaymentIntentId  String
  amount                 Int
  currency               String   @default("TND")
  /// Statut : "pending" | "authorized" | "captured" | "cancelled" | "refunded"
  status                 String   @default("pending")
  authorizedAt           DateTime?
  capturedAt             DateTime?
  cancelledAt            DateTime?
  refundedAt             DateTime?
  metadata               Json?
  createdAt              DateTime @default(now())

  @@index([reservationId])
  @@index([guestId])
  @@index([restaurantId, status])
}

/// Split d'addition.
model BillSplit {
  id           String   @id @default(cuid())
  reservationId String
  reservation  Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  totalAmount  Int
  tipAmount    Int      @default(0)
  /// Statut : "pending" | "partial" | "completed"
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items BillSplitItem[]

  @@index([reservationId])
  @@index([restaurantId])
}

/// Ligne d'un split d'addition.
model BillSplitItem {
  id          String    @id @default(cuid())
  splitId     String
  split       BillSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  orderItemId String
  guestId     String?
  amount      Int
  createdAt   DateTime @default(now())

  @@index([splitId])
}

// ─── AI Brain ──────────────────────────────────────────────────────

/// Configuration IA du restaurant (provider, modèle, seuils).
model AiConfig {
  id            String   @id @default(cuid())
  restaurantId  String
  provider      String   @default("anthropic") // anthropic | openai | local
  model         String   @default("claude-sonnet-4-20250514")
  maxTokens     Int      @default(1024)
  temperature   Float    @default(0.7)
  dailyBudgetCents Int   @default(5000) // 50 USD
  monthlyBudgetCents Int @default(100000) // 1000 USD
  enabled       Boolean  @default(true)
  fallbackProvider String? // provider de secours
  fallbackModel    String?
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId])
  @@index([restaurantId])
}

/// Journal d'audit de toutes les requêtes IA.
model AiAuditLog {
  id            String   @id @default(cuid())
  restaurantId  String
  provider      String   // anthropic | openai
  model         String
  operation     String   // chat | voice | menu_gen | review_reply | ...
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costCents     Int      @default(0)
  latencyMs     Int      @default(0)
  success       Boolean  @default(true)
  errorMessage  String?
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, provider])
  @@index([restaurantId, operation])
}

/// Suivi des coûts IA agrégés par jour/provider/modèle.
model AiCostEntry {
  id            String   @id @default(cuid())
  restaurantId  String
  provider      String
  model         String
  date          DateTime @db.Date
  requestCount  Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costCents     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId, provider, model, date])
  @@index([restaurantId, date])
}
