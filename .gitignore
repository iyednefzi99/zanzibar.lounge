# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — aucun secret ne doit être versionné.
# `.env.example` est l'exception : il ne contient que des valeurs vides.
.env*
!.env.example

# client Prisma généré (régénéré par `npm install` via le script postinstall)
/src/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
