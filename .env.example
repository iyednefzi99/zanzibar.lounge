# Zanzibar Lounge — variables d'environnement
#
# Copier ce fichier en `.env.local` (jamais versionné) et remplir les valeurs.
# Le site tourne avec la seule DATABASE_URL : l'agent WhatsApp/SMS reste hors
# service tant que ses clés sont absentes, sans rien casser d'autre.

# --- Base de données (Neon, Supabase, ou tout Postgres) -----------------------
# Connexion applicative, via le pooler si votre hébergeur en propose un.
DATABASE_URL="postgresql://user:password@host:5432/zanzibar?sslmode=require"
# Connexion directe, utilisée par les migrations Prisma (sans pooler).
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/zanzibar?sslmode=require"

# --- Agent IA ----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# https://developers.facebook.com → votre application → WhatsApp → Configuration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Jeton que VOUS choisissez et que vous recopiez dans la configuration du
# webhook Meta. Générer avec : openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=""
# Paramètres de l'application → Clé secrète. Sert à vérifier la signature des
# webhooks : sans elle, n'importe qui peut faire parler l'agent.
WHATSAPP_APP_SECRET=""
# Nom du modèle approuvé pour les rappels. Hors des 24 h suivant le dernier
# message du client, Meta n'accepte que des modèles. Sans lui, les rappels
# partent en SMS.
WHATSAPP_REMINDER_TEMPLATE="rappel_reservation"

# --- Twilio (SMS) ------------------------------------------------------------
# https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Numéro expéditeur (+216…) ou identifiant d'un Messaging Service (MG…).
TWILIO_FROM=""

# --- Anti-abus ---------------------------------------------------------------
# Exige un code à six chiffres avant toute réservation en ligne. Ajoute une
# étape au parcours : à activer si les fausses réservations deviennent un
# problème. Le code part par WhatsApp ou SMS, donc chaque envoi coûte.
BOOKING_REQUIRE_OTP="false"

# Limitation de débit partagée entre instances. Sans ces deux variables, les
# compteurs restent en mémoire : sur plusieurs instances serverless, la limite
# réelle est multipliée par leur nombre. https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Exploitation ------------------------------------------------------------
# Protège /api/cron/reminders. Générer avec : openssl rand -hex 32
CRON_SECRET=""
# Back-office /fr/admin — authentification HTTP Basic.
# Mot de passe long et unique : 16 caractères minimum, jamais réutilisé.
ADMIN_USER="salle"
ADMIN_PASSWORD=""

# URL publique du site. Sert aussi à vérifier la signature des webhooks Twilio :
# elle doit correspondre exactement à celle enregistrée dans la console Twilio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
